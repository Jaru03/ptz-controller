# Configuración del controlador de cámaras PTZ ONVIF.
#
# Ajuste al menos la IP, el usuario y la contraseña de su cámara, y ponga
# 'mock: false' para usarla de verdad.
#
# Desde el código fuente: copie este archivo a config.yaml en la raíz del
# proyecto. El ejecutable instalado ya lo copia solo la primera vez, a
# ~/.config/ptz-controller/config.yaml (Linux) o
# %APPDATA%\ptz-controller\config.yaml (Windows).
camera:
    ip: 192.168.1.100
    port: 80
    username: admin
    password: ""
    rtsp_url: ""
    mock: true

movement:
    speed: 0.5
    speeds:
        - 0.2
        - 0.5
        - 0.8
    deadzone: 0.08
    # Intervalo de reenvío de ContinuousMove mientras se mantiene el
    # movimiento (ms). Evita que algunas cámaras se queden detenidas
    # tras recibir un único comando y no llegar otro paquete.
    repeat_interval_ms: 150
    # Cómo se controla el zoom (E/Q):
    #   continuous: ContinuousMove + Stop, igual que el pan/tilt. Por
    #               defecto: lo soportan prácticamente todas las cámaras.
    #   step:       RelativeMove de zoom_step por repetición. El zoom
    #               avanza a saltos y para en posiciones intermedias, pero
    #               algunas cámaras aceptan el RelativeMove sin dar error
    #               y sin mover el zoom realmente.
    #   auto:       intenta 'step' y cae a 'continuous' solo si la cámara
    #               rechaza el RelativeMove con un error.
    zoom_mode: continuous
    zoom_step: 0.06

keyboard:
    backend: auto
    # auto: pynput global, con fallback al teclado de ventana
    # pynput: solo teclado global (X11 / grupo input en Linux)
    # window: solo eventos de la propia ventana (fiable en Wayland y
    #         Windows). Se llamaba 'qt' antes de la migración a pywebview;
    #         ese valor se sigue aceptando y se normaliza automáticamente.
    up: w
    down: s
    left: a
    right: d
    zoom_in: e
    zoom_out: q
    # Teclas de escena, asignadas POR POSICIÓN a los presets que
    # devuelve la cámara: la 1ª tecla va al 1er preset, etc. Funciona
    # con cualquier token ONVIF (numérico o no) y sin tocar nada al
    # añadir escenas. Las teclas del pad numérico ('kp_1'...'kp_0')
    # caen a su dígito si no tienen asignación propia.
    preset_keys: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]
    # Atajos fijos tecla -> token ONVIF concreto (tienen prioridad).
    # Útil para escenas con token no numérico:
    #   preset_hotkeys:
    #       f1: PresetEntrada
    #       kp_5: "12"
    preset_hotkeys: {}
    stop: space
    quit: esc

joystick:
    poll_rate: 30
    deadzone: 0.08
    pan_axis: 0
    tilt_axis: 1
    invert_tilt: true
    zoom_out_axis: 4
    zoom_in_axis: 5
    speed_down_button: 5
    speed_up_button: 4
    home_button: 12
    # Botones de escena, también por posición (1er botón -> 1er preset).
    preset_buttons: [0, 1, 2, 3]
    device_overrides: {}

gui:
    poll_interval_ms: 33
    video_fps: 15
    # Transporte RTSP para la vista previa: 'tcp' evita la pérdida de
    # paquetes (RTP/UDP) que provoca errores H.264 de referencias.
    rtsp_transport: tcp

logging:
    level: INFO
    directory: logs
